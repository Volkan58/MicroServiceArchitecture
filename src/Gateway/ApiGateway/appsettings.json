{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "products": {
        "ClusterId": "products",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "logs": {
        "ClusterId": "logs",
        "Match": {
          "Path": "/api/logs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "products": {
        "Destinations": {
          "products1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "logs": {
        "Destinations": {
          "logs1": {
            "Address": "http://localhost:5034"
          }
        }
      }
    }
  }
}
